<?xml version="1.0"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

	<!-- Fixed vocabulary of channel roles. The list is deliberately closed: a boundary
	     condition input and a dataset channel both name a role from this enumeration,
	     which is what makes their pairing automatic. New roles ship together with the
	     engine model that consumes them. -->
	<xs:simpleType name="ChannelRole" final="restriction">
		<xs:restriction base="xs:string">
			<xs:enumeration value="AirTemperature"/>
			<xs:enumeration value="RelativeHumidity"/>
			<xs:enumeration value="WindSpeed"/>
			<xs:enumeration value="WindDirection"/>
			<xs:enumeration value="SolarIrradiance"/>
			<xs:enumeration value="HeatFlux"/>
			<xs:enumeration value="ConvectiveCoefficient"/>
			<xs:enumeration value="RadiantTemperature"/>
			<xs:enumeration value="RadiativeCoefficient"/>
			<xs:enumeration value="Emissivity"/>
			<xs:enumeration value="PrescribedTemperature"/>
			<xs:enumeration value="PrescribedHumidity"/>
		</xs:restriction>
	</xs:simpleType>

	<!-- One time series: a role plus its values. Rows are implicitly indexed; step
	     duration is a simulation setting in the model file, not a dataset property.
	     One channel per role per dataset; enforced by the loader. -->
	<xs:complexType name="Channel">
		<xs:sequence>
			<xs:element name="Role" type="ChannelRole"/>
			<xs:element name="Value" type="xs:double" minOccurs="1" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="Environment">
		<xs:sequence>
			<xs:element name="UUID" type="xs:string"/>
			<xs:element name="Name" type="xs:string"/>
			<xs:element name="Protected" type="xs:boolean"/>
			<xs:element name="Description" type="xs:string" minOccurs="0"/>
			<xs:element name="Channel" type="Channel" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>

	<xs:element name="EnvironmentData">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Version" type="xs:string"/>
				<xs:element name="Environment" type="Environment" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>

</xs:schema>
